+/**
+ * Publish one staged object into place.
+ * Android refuses link() for untrusted apps (EACCES: no hard links).
+ * rename() inside the same private root is equally atomic, so fall back to it.
+ */
+/* termux-hardlink-fallback */
+async function publishStagedName(source, target) {
+	try {
+		await link(source, target);
+	} catch (error) {
+		if (!(error instanceof Error && "code" in error && error.code === "EACCES")) throw error;
+		await rename(source, target);
+	}
+}
+/** Remove a staging name, tolerating one already consumed by the rename fallback. */
+async function removeStagedName(path) {
+	try {
+		await unlink(path);
+	} catch (error) {
+		if (!(error instanceof Error && "code" in error && error.code === "ENOENT")) throw error;
+	}
+}
